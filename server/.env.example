MEWSO_SERVER_PORT=8080
MEWSO_DATABASE_HOST=127.0.0.1
MEWSO_DATABASE_PORT=3306
MEWSO_DATABASE_USER=root
MEWSO_DATABASE_PASSWORD=your_password
MEWSO_DATABASE_DB_NAME=mewsoproxy
MEWSO_DATABASE_AUTO_MIGRATE=false
MEWSO_REDIS_ADDR=127.0.0.1:6379
MEWSO_REDIS_PASSWORD=
MEWSO_REDIS_DB=0
MEWSO_APP_REGISTER_ENABLED=true
MEWSO_APP_DEFAULT_GROUP_ID=1

# 密钥文件：留空则每次启动在内存中随机生成（不落盘）
# 设置后：首次启动自动生成并写入该文件，重启保持稳定
MEWSO_APP_SECRETS_FILE=

# 默认管理员（仅在数据库无管理员时分机创建，请务必改为强密码）
MEWSO_ADMIN_EMAIL=admin@test.com
MEWSO_ADMIN_PASSWORD=admin123

# JWT / SSH / 节点 token 密钥：留空或为占位值将由系统自动生成
# 如需固定，可设置：
# MEWSO_JWT_ACCESS_SECRET=<32字节随机串>
# MEWSO_JWT_REFRESH_SECRET=<32字节随机串>
# MEWSO_APP_SSH_ENCRYPT_KEY=<32字节随机串>
# MEWSO_APP_SERVER_TOKEN=<32字节随机串>
